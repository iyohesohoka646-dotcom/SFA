        "timeout_seconds": {
          "default": 60,
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "credential_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        },
        "configured": {
          "default": false,
          "title": "Configured",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "protocol",
        "base_url",
        "models",
        "default_model",
        "timeout_seconds",
        "credential_ref",
        "configured"
      ],
      "title": "PublicProviderProfile",
      "type": "object"
    }
